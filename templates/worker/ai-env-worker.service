# systemd unit for a worker behind the ai-env relay: copy to /etc/systemd/system/ai-env-worker.service.
[Unit]
Description=ai-env relay worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ai-env-worker
Group=ai-env-worker
ExecStart=/usr/local/bin/my-worker run --config /etc/ai-env-worker/worker.toml
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
UMask=0077
ReadOnlyPaths=/etc/ai-env-worker
# A source that reads files elsewhere (logs, for example) adds each of them here with ReadOnlyPaths=.

[Install]
WantedBy=multi-user.target
