    { "file_path": "/var/log/ai-env-relay/relay.log", "log_group_name": "@LOG_GROUP@", "log_stream_name": "{instance_id}/relay", "retention_in_days": -1 },
    { "file_path": "/var/log/ai-env-relay/reload.log", "log_group_name": "@LOG_GROUP@", "log_stream_name": "{instance_id}/reload", "retention_in_days": -1 },
    { "file_path": "/var/log/ai-env-relay/patch.log", "log_group_name": "@LOG_GROUP@", "log_stream_name": "{instance_id}/patch", "retention_in_days": -1 }
  ] } } }
}
